                    "additionalProperties": true
                  },
                  "provider": {
                    "enum": [
                      "external",
                      "codex"
                    ]
                  },
                  "needs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/Need"
                    }
