                  "running": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string"
                  },
                  "progress": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 99
                  }
                },
                "required": [
                  "leaseToken"
                ]
              }
            }
